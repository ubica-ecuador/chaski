    "variables": [
      {
        "kind": "QueryVariable",
        "spec": {
          "allowCustomValue": true,
          "current": {
            "text": "",
            "value": ""
          },
          "hide": "hideVariable",
          "includeAll": false,
          "multi": false,
          "name": "gaia",
          "options": [],
          "query": {
            "datasource": {
              "name": "duckdbwasm"
            },
            "group": "ubica-chaski-datasource",
            "kind": "DataQuery",
            "version": "v0",
            "spec": {
              "refId": "gaia",
              "kind": "dataset",
              "name": "gaia",
              "source": {
                "type": "sql",
                "sql": "-- Galactic longitude and latitude projected (Natural Earth) to u, v, as Mosaic's example does.\nWITH prep AS (\n  SELECT\n    radians((-l + 540) % 360 - 180) AS lam,\n    radians(b) AS phi,\n    asin(sqrt(3) / 2 * sin(phi)) AS t,\n    t ^ 2 AS t2,\n    t2 ^ 3 AS t6,\n    *\n  FROM read_parquet('https://pub-1da360b43ceb401c809f68ca37c7f8a4.r2.dev/data/gaia-5m.parquet')\n  WHERE parallax BETWEEN -5 AND 20 AND phot_g_mean_mag IS NOT NULL AND bp_rp IS NOT NULL\n)\nSELECT\n  (1.340264 * lam * cos(t)) / (sqrt(3) / 2 * (1.340264 + (-0.081106 * 3 * t2) + (t6 * (0.000893 * 7 + 0.003796 * 9 * t2)))) AS u,\n  t * (1.340264 + (-0.081106 * t2) + (t6 * (0.000893 + 0.003796 * t2))) AS v,\n  l, b, parallax, phot_g_mean_mag, bp_rp\nFROM prep"
              }
            }
          },
          "refresh": "onDashboardLoad",
          "regex": "",
          "regexApplyTo": "value",
          "skipUrlSync": true,
          "sort": "disabled"
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "current": {
            "text": "",
            "value": ""
