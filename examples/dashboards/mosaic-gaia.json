      {
        "kind": "QueryVariable",
        "spec": {
          "allowCustomValue": true,
          "current": {
            "text": "",
            "value": ""
          },
          "hide": "hideVariable",
          "includeAll": false,
          "multi": false,
          "name": "gaiaFilters",
          "options": [],
          "query": {
            "datasource": {
              "name": "duckdbwasm"
            },
            "group": "ubica-chaski-datasource",
            "kind": "DataQuery",
            "version": "v0",
            "spec": {
              "refId": "gaiaFilters",
              "kind": "filters",
              "dataset": "$gaia",
              "filters": [
                {
                  "name": "sky_u",
                  "type": "range",
                  "column": "u",
                  "from": "$g_u_lo",
                  "to": "$g_u_hi",
                  "label": "Sky, across",
                  "upper": "closed"
                },
                {
                  "name": "sky_v",
                  "type": "range",
                  "column": "v",
                  "from": "$g_v_lo",
                  "to": "$g_v_hi",
                  "label": "Sky, up",
                  "upper": "closed"
                },
                {
                  "name": "mag",
                  "type": "range",
                  "column": "phot_g_mean_mag",
                  "from": "$g_mag_lo",
                  "to": "$g_mag_hi",
                  "label": "G magnitude",
                  "upper": "closed"
                },
                {
                  "name": "parallax",
                  "type": "range",
                  "column": "parallax",
                  "from": "$g_par_lo",
                  "to": "$g_par_hi",
                  "label": "Parallax (mas)",
                  "upper": "closed"
                },
                {
                  "name": "hr_colour",
                  "type": "range",
                  "column": "bp_rp",
                  "from": "$g_c_lo",
                  "to": "$g_c_hi",
                  "label": "HR: colour (BP−RP)",
                  "upper": "closed"
                },
                {
                  "name": "hr_mag",
                  "type": "range",
                  "column": "phot_g_mean_mag",
                  "from": "$g_hm_lo",
                  "to": "$g_hm_hi",
                  "label": "HR: G magnitude",
                  "upper": "closed"
                }
              ]
            }
          },
          "refresh": "onDashboardLoad",
          "regex": "",
          "regexApplyTo": "value",
          "skipUrlSync": true,
          "sort": "disabled"
        }
      }
