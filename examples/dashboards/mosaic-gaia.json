    "elements": {
      "g-count": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Stars",
          "description": "Stars of the 5-million sample the brushes leave.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "ubica-chaski-mosaic-panel",
            "spec": {
              "options": {
                "spec": "params:\n  gbrush: { select: crossfilter }\n  gbandwidth: 0\n  gpixel: 2\n  gscale: sqrt\n\nplot:\n  - mark: text\n    data: { from: gaia, filterBy: $gbrush }\n    text: { count: }\n    frameAnchor: middle\n    fill: \"#5794F2\"\n    fontSize: 40\n    fontWeight: 500\nxAxis: null\nyAxis: null\nmargin: 0\n",
                "variables": "",
                "preaggregate": true
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "g-near": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Within 100 parsecs",
          "description": "Parallax of 10 milliarcseconds or more: closer than about 326 light years.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "ubica-chaski-mosaic-panel",
            "spec": {
              "options": {
                "spec": "params:\n  gbrush: { select: crossfilter }\n  gbandwidth: 0\n  gpixel: 2\n  gscale: sqrt\n\nplot:\n  - mark: text\n    data: { from: gaia, filterBy: $gbrush }\n    text: { sum: { sql: \"(parallax >= 10)::INTEGER\" } }\n    frameAnchor: middle\n    fill: \"#FADE2A\"\n    fontSize: 40\n    fontWeight: 500\nxAxis: null\nyAxis: null\nmargin: 0\n",
                "variables": "",
                "preaggregate": true
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "g-distance": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Median distance",
          "description": "1000 / parallax, over the stars with a positive parallax: a rough distance, since parallaxes this small are noisy.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "A",
                    "query": {
                      "datasource": {
                        "name": "duckdbwasm"
                      },
                      "group": "ubica-chaski-datasource",
                      "kind": "DataQuery",
                      "version": "v0",
                      "spec": {
                        "rawSql": "SELECT median(1000 / parallax) FILTER (WHERE parallax > 0)::DOUBLE AS d FROM $gaia WHERE $__crossfilter($gaiaFilters)"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": ["lastNotNull"],
                  "fields": "",
                  "values": false
                },
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "center",
                "textMode": "value",
                "orientation": "auto",
                "wideLayout": true,
                "showPercentChange": false
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "suffix: pc",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "#B877D9"
                  },
                  "decimals": 0
                },
                "overrides": []
              }
            }
          }
        }
      },
      "g-colour": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Median colour",
          "description": "BP − RP: blue stars are low, red ones high.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "A",
                    "query": {
                      "datasource": {
                        "name": "duckdbwasm"
                      },
                      "group": "ubica-chaski-datasource",
                      "kind": "DataQuery",
                      "version": "v0",
                      "spec": {
                        "rawSql": "SELECT median(bp_rp)::DOUBLE AS c FROM $gaia WHERE $__crossfilter($gaiaFilters)"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": ["lastNotNull"],
                  "fields": "",
                  "values": false
                },
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "center",
                "textMode": "value",
                "orientation": "auto",
                "wideLayout": true,
                "showPercentChange": false
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "#FF9830"
                  },
                  "decimals": 2
                },
                "overrides": []
              }
            }
          }
        }
      },
      "g-sky": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "The Milky Way, 5 million stars",
          "description": "Mosaic's Gaia example: star density across the sky in galactic coordinates, computed in DuckDB and drawn as a raster. Drag a box to select a patch of sky; everything else follows.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "ubica-chaski-mosaic-panel",
            "spec": {
              "options": {
                "spec": "params:\n  gbrush: { select: crossfilter }\n  gbandwidth: 0\n  gpixel: 2\n  gscale: sqrt\n\nvconcat:\n  - hconcat:\n      - input: slider\n        label: Smoothing (σ)\n        as: $gbandwidth\n        min: 0\n        max: 10\n        step: 0.1\n      - input: menu\n        label: Pixel size\n        as: $gpixel\n        options: [0.5, 1, 2]\n      - input: menu\n        label: Scale\n        as: $gscale\n        options: [log, linear, sqrt]\n  - plot:\n      - mark: raster\n        data: { from: gaia, filterBy: $gbrush }\n        x: u\n        y: v\n        fill: density\n        bandwidth: $gbandwidth\n        pixelSize: $gpixel\n      - select: intervalXY\n        pixelSize: 2\n        as: $gbrush\n    xyDomain: Fixed\n    colorScale: $gscale\n    colorScheme: inferno\n    margin: 0\n    xAxis: null\n    yAxis: null\n",
                "variables": "- param: gbrush\n  column: [u, v]\n  from: [g_u_lo, g_v_lo]\n  to: [g_u_hi, g_v_hi]\n",
                "preaggregate": true
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "g-mag": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Brightness (G magnitude)",
          "description": "Lower is brighter. Drag to select a range.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "ubica-chaski-mosaic-panel",
            "spec": {
              "options": {
                "spec": "params:\n  gbrush: { select: crossfilter }\n  gbandwidth: 0\n  gpixel: 2\n  gscale: sqrt\n\nplot:\n  - mark: rectY\n    data: { from: gaia, filterBy: $gbrush }\n    x: { bin: phot_g_mean_mag }\n    y: { count: }\n    fill: \"#5794F2\"\n    inset: 0.5\n  - select: intervalX\n    as: $gbrush\nxDomain: Fixed\nyScale: $gscale\nyGrid: true\nyTickFormat: '~s'\nxLabel: null\nyLabel: null\nmarginLeft: 45\n",
                "variables": "- param: gbrush\n  column: phot_g_mean_mag\n  from: g_mag_lo\n  to: g_mag_hi\n",
                "preaggregate": true
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "g-parallax": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Parallax (mas)",
          "description": "Higher is closer. Select the high end to keep the nearby stars, and watch the main sequence appear in the HR diagram.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "ubica-chaski-mosaic-panel",
            "spec": {
              "options": {
                "spec": "params:\n  gbrush: { select: crossfilter }\n  gbandwidth: 0\n  gpixel: 2\n  gscale: sqrt\n\nplot:\n  - mark: rectY\n    data: { from: gaia, filterBy: $gbrush }\n    x: { bin: parallax }\n    y: { count: }\n    fill: \"#73BF69\"\n    inset: 0.5\n  - select: intervalX\n    as: $gbrush\nxDomain: Fixed\nyScale: $gscale\nyGrid: true\nyTickFormat: '~s'\nxLabel: null\nyLabel: null\nmarginLeft: 45\n",
                "variables": "- param: gbrush\n  column: parallax\n  from: g_par_lo\n  to: g_par_hi\n",
                "preaggregate": true
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "g-hr": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Hertzsprung–Russell diagram",
          "description": "Colour against brightness. Stars far away blur into a smear; select high parallaxes and the main sequence, the giants and the white dwarfs separate. Drag a box to select stars by type.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "ubica-chaski-mosaic-panel",
            "spec": {
              "options": {
                "spec": "params:\n  gbrush: { select: crossfilter }\n  gbandwidth: 0\n  gpixel: 2\n  gscale: sqrt\n\nplot:\n  - mark: raster\n    data: { from: gaia, filterBy: $gbrush }\n    x: bp_rp\n    y: phot_g_mean_mag\n    fill: density\n    bandwidth: $gbandwidth\n    pixelSize: $gpixel\n  - select: intervalXY\n    pixelSize: 2\n    as: $gbrush\nxyDomain: Fixed\ncolorScale: $gscale\ncolorScheme: magma\nyReverse: true\nxLabel: Colour, BP − RP →\nyLabel: ↑ G magnitude\nmarginLeft: 35\n",
                "variables": "- param: gbrush\n  column: [bp_rp, phot_g_mean_mag]\n  from: [g_c_lo, g_hm_lo]\n  to: [g_c_hi, g_hm_hi]\n",
                "preaggregate": true
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "g-about": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "Reading it",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "spec": {
              "options": {
                "mode": "markdown",
                "content": "**5 million stars**, a sample of the 1.8 billion in ESA's Gaia catalogue, loaded into DuckDB in your browser.\n\n- The **sky map** projects galactic longitude and latitude, so the Milky Way's disc runs across the middle with its centre in the middle; the two bright patches below it are the Large and Small Magellanic Clouds, galaxies of their own. Dark lanes are dust.\n- **Try this:** in *Parallax*, select from about 5 mas up. Only nearby stars remain, and the **HR diagram** sharpens into the main sequence, the red giants above it and the white dwarfs below.\n- **Stars** and **Within 100 parsecs** are Mosaic panels and follow a brush as it moves; the medians, which Mosaic cannot pre-aggregate, are Grafana panels that update when it stops.\n\nData: [ESA Gaia](https://www.cosmos.esa.int/gaia) DR2 sample from [Mosaic's examples](https://idl.uw.edu/mosaic/examples/gaia.html), CC BY-SA 3.0 IGO. About 100 MB: it takes a moment to load.\n"
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "g-filters": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Active filters",
          "description": "What the Mosaic brushes on this tab wrote to the dashboard's variables, as Chaski's cross-filters read them.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "A",
                    "query": {
                      "datasource": {
                        "name": "duckdbwasm"
                      },
                      "group": "ubica-chaski-datasource",
                      "kind": "DataQuery",
                      "version": "v0",
                      "spec": {
                        "rawSql": "SELECT label AS Filter, value AS Range FROM $__filters($gaiaFilters) WHERE active"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "spec": {
              "options": {
                "showHeader": true,
                "cellHeight": "sm",
                "footer": {
                  "show": false
                }
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "GridLayout",
      "spec": {
        "items": [
          {
            "kind": "GridLayoutItem",
            "spec": {
              "element": {
                "kind": "ElementReference",
                "name": "g-count"
