                      "group": "ubica-chaski-datasource",
                      "kind": "DataQuery",
                      "version": "v0",
                      "spec": {
                        "rawSql": "SELECT * FROM (\n  SELECT px AS lng0, py AS lat0, dx AS lng1, dy AS lat1, fare, distance, round(hour, 2) AS hour, paid\n  FROM $rides\n  WHERE $__crossfilter($rideFilters, -drawn, -view_lng, -view_lat)\n) USING SAMPLE reservoir(12000 ROWS) REPEATABLE (7)"
