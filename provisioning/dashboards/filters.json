  "templating": {
    "list": [
      {
        "name": "quakes",
        "type": "query",
        "hide": 2,
        "skipUrlSync": true,
        "refresh": 1,
        "datasource": {
          "type": "ubica-chaski-datasource",
          "uid": "duckdbwasm"
        },
        "query": {
          "refId": "quakes",
          "kind": "dataset",
          "name": "quakes",
          "source": {
            "type": "sql",
            "sql": "WITH u AS (\n  SELECT i,\n    (hash(i * 8 + 1) % 1000000)::DOUBLE / 1e6 AS u1,\n    (hash(i * 8 + 2) % 1000000)::DOUBLE / 1e6 AS u2,\n    (hash(i * 8 + 3) % 1000000)::DOUBLE / 1e6 AS u3,\n    (hash(i * 8 + 4) % 1000000)::DOUBLE / 1e6 AS u4,\n    (hash(i * 8 + 5) % 1000000)::DOUBLE / 1e6 AS u5,\n    (hash(i * 8 + 6) % 1000000)::DOUBLE / 1e6 AS u6\n  FROM range(50000) t(i)\n)\nSELECT i AS id,\n  TIMESTAMP '2026-09-01' + to_seconds(floor(pow(u5, 0.7) * 2592000)::BIGINT) AS time,\n  -180 + 360 * u1 AS longitude,\n  30 * sin(radians(2 * (-180 + 360 * u1))) + (u2 - 0.5) * 24 AS latitude,\n  round(least(-ln(u3 + 1e-6) * 1.1, 9.0), 2) AS mag,\n  round(least(-ln(u3 + 1e-6) * 1.1, 9.0) * 35 + u4 * 80, 1) AS depth,\n  CASE WHEN u6 < 0.86 THEN 'earthquake' WHEN u6 < 0.93 THEN 'explosion' WHEN u6 < 0.98 THEN 'quarry blast' ELSE 'ice quake' END AS kind,\n  ['us', 'ci', 'ak', 'nc', 'hv', 'uw'][1 + (i % 6)::INTEGER] AS net,\n  'Zone ' || lpad(((hash(i * 8 + 7) % 40)::INTEGER)::VARCHAR, 2, '0') || ', ' || CASE WHEN u2 < 0.5 THEN 'north' ELSE 'south' END AS place\nFROM u"
          }
        }
      },
