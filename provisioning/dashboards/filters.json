      {
        "name": "quakeFilters",
        "type": "query",
        "hide": 2,
        "skipUrlSync": true,
        "refresh": 1,
        "datasource": {
          "type": "ubica-chaski-datasource",
          "uid": "duckdbwasm"
        },
        "query": {
          "refId": "quakeFilters",
          "kind": "filters",
          "dataset": "$quakes",
          "filters": [
            {
              "name": "time",
              "type": "range",
              "column": "time",
              "as": "time",
              "from": "$t0",
              "to": "$t1",
              "label": "Time"
            },
            {
              "name": "mag",
              "type": "range",
              "column": "mag",
              "from": "$mag_lo",
              "to": "$mag_hi",
              "label": "Magnitude",
              "upper": "closed"
            },
            {
              "name": "depth",
              "type": "range",
              "column": "depth",
              "from": "$depth_lo",
              "to": "$depth_hi",
              "label": "Depth (km)",
              "upper": "closed"
            },
            {
              "name": "kind",
              "type": "in",
              "column": "kind",
              "variable": "$kinds",
              "label": "Kind"
            },
            {
              "name": "net",
              "type": "equals",
              "column": "net",
              "variable": "$net",
              "label": "Network"
            },
            {
              "name": "place",
              "type": "search",
              "column": "place",
              "variable": "$q",
              "label": "Place"
            },
            {
              "name": "area",
              "type": "area",
              "variable": "$area",
              "lat": "latitude",
              "lng": "longitude",
              "label": "Area"
            }
          ]
        }
      }
    ]
