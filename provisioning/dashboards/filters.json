    {
      "id": 3,
      "type": "table",
      "title": "Read by Chaski SQL",
      "datasource": {
        "type": "ubica-chaski-datasource",
        "uid": "duckdbwasm"
      },
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "ubica-chaski-datasource",
            "uid": "duckdbwasm"
          },
          "rawSql": "SELECT count(*)::DOUBLE AS quakes, round(avg(mag), 2) AS \"mean magnitude\", round(avg(depth), 1) AS \"mean depth\"\nFROM $quakes\nWHERE $__crossfilter($quakeFilters)"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "ubica-chaski-mosaic-panel",
      "title": "Magnitude (Mosaic)",
      "description": "A Mosaic brush on the same variables as the Magnitude filter: brush here and the filters panel follows. Mosaic draws only its own selection: it reads the other filters only through its Read from variables option.",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 3
      },
      "options": {
        "spec": "params:\n  brush: { select: crossfilter }\nplot:\n  - mark: rectY\n    data: { from: quakes, filterBy: $brush }\n    x: { bin: mag }\n    y: { count: }\n    fill: steelblue\n  - select: intervalX\n    as: $brush\nxDomain: Fixed\n",
        "variables": "- param: brush\n  column: mag\n  from: mag_lo\n  to: mag_hi\n",
        "reads": "",
        "preaggregate": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Quakes",
      "datasource": {
        "type": "ubica-chaski-datasource",
        "uid": "duckdbwasm"
      },
      "gridPos": {
        "h": 12,
        "w": 18,
        "x": 6,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "ubica-chaski-datasource",
            "uid": "duckdbwasm"
          },
          "rawSql": "SELECT time, mag, depth, kind, net, place\nFROM $quakes\nWHERE $__crossfilter($quakeFilters)\nORDER BY mag DESC\nLIMIT 100"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
