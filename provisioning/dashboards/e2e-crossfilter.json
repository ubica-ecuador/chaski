      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "ubica-chaski-datasource",
            "uid": "duckdbwasm"
          },
          "rawSql": "SELECT count(*)::DOUBLE AS n FROM $sample WHERE city IN ($city) AND v >= coalesce(try_cast($v_lo AS DOUBLE), '-infinity'::DOUBLE) AND v < coalesce(try_cast($v_hi AS DOUBLE), 'infinity'::DOUBLE) AND t >= coalesce(try_cast($t0 AS TIMESTAMP), '-infinity'::TIMESTAMP) AND t < coalesce(try_cast($t1 AS TIMESTAMP), 'infinity'::TIMESTAMP) AND contains(lower(city), lower($q))"
        }
      ]
    },
